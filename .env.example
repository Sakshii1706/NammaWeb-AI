# ============================================================
# NAMMAWEB AI ENVIRONMENT CONFIGURATION
# ============================================================

# Application
NAMMAWEB_APP_NAME=NammaWeb AI
NAMMAWEB_APP_ENV=development
NAMMAWEB_HOST=127.0.0.1
NAMMAWEB_PORT=8502

# Storage
NAMMAWEB_DOCUMENTS_PATH=documents
NAMMAWEB_FAISS_PATH=data/faiss_index

# RAG
NAMMAWEB_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NAMMAWEB_RAG_TOP_K=4
NAMMAWEB_CHUNK_SIZE=400
NAMMAWEB_CHUNK_OVERLAP=100
NAMMAWEB_MAX_CONTEXT_CHARS_PER_SOURCE=4000

# Local LLM
NAMMAWEB_OLLAMA_MODEL=llama3.2:3b
NAMMAWEB_LLM_TEMPERATURE=0
NAMMAWEB_LLM_NUM_PREDICT=192
NAMMAWEB_LLM_KEEP_ALIVE=24h
